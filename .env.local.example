# Foundy · Environment Variables · .env.local.example
# Copy to .env.local and fill in real values. Never commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://dsoogbszstfwsjcahlod.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_FOUNDING=price_...   # £75/mo · max 5 uses
STRIPE_PRICE_CORE=price_...       # £90/mo
STRIPE_PRICE_FULL=price_...       # £175/mo

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://foundy.studio
NEXT_PUBLIC_FOUNDING_SLOTS_TOTAL=5

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=hello@foundy.studio

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=jesse@foundy.studio
